{
  "schema_version": "1.0.0",
  "protocol_id": "ictc-m14-confirmatory-v1",
  "frozen_inputs": {
    "baseline_registry": "configs/baselines/m09_frozen.json",
    "simulation_matrix": "configs/experiments/m10r_revision_matrix.json",
    "condition_map": "configs/experiments/m14_condition_map.json",
    "ns3_matrix": "configs/experiments/m14_final_ns3_matrix.json",
    "packet_prototype": "src/ictc/prototype/windows.py"
  },
  "simulation": {
    "topology_splits": ["train", "development", "test"],
    "topology_families": 7,
    "traffic_levels": ["low", "medium", "high"],
    "observation_regimes": ["complete", "delayed", "missing", "skewed-stale"],
    "principal_test_seeds": 20,
    "conditions": ["complete", "missing", "stale", "delayed", "clock_skew", "source_failure", "malicious_telemetry", "topology_change", "unseen_topology", "cross_traffic_shift", "contract_infeasibility"],
    "controllers": ["A0", "B0", "B1", "B2", "B3", "B4", "B5", "B6", "B7", "B8"],
    "ablation_ids": ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "A7", "A8", "A9", "A10", "A11", "A12", "A13", "A14", "A15", "A16"]
  },
  "ns3": {
    "topologies": ["two-path", "three-path"],
    "traffic_levels": ["low", "medium", "high"],
    "actions": ["keep", "reroute", "alternate"],
    "planned_action_executions": 300,
    "seeds_per_principal_condition": 20,
    "failure_rule": "Retain failed runs with stderr and classification; rerun only demonstrably corrupted or incomplete outputs under the same run id and frozen configuration."
  },
  "prototype": {
    "repetitions": 20,
    "scenario": "Windows-native M12 loopback UDP route-change, telemetry-breach, and fallback trace",
    "required_artifacts": ["events.jsonl", "traffic.pcap", "capture.json", "alignment.json"]
  },
  "endpoints": {
    "primary": ["false_admissions", "harmful_action_rate_among_admissions", "admission_fraction"],
    "secondary": ["unnecessary_deferrals", "telemetry_bytes", "deadline_miss_rate", "latency", "loss", "jitter", "queue_occupancy", "protocol_overhead", "capture_alignment_delta_ns"],
    "prohibited_interpretation": "Population ATE calibration is not an individual safety guarantee."
  },
  "statistics": {
    "confidence_intervals": "two-sided 95% paired bootstrap intervals with 10,000 resamples",
    "paired_tests": "two-sided exact McNemar for paired binary endpoints; Wilcoxon signed-rank for paired continuous endpoints with a documented permutation fallback",
    "multiplicity": "Holm correction across the declared primary controller comparisons",
    "effect_sizes": "risk difference for binary endpoints; Hodges-Lehmann paired shift for continuous endpoints"
  },
  "exclusions": {
    "allowed": ["missing immutable artifact", "checksum mismatch", "malformed output", "documented process crash before outcome"],
    "forbidden": ["unfavourable metric", "high latency", "loss", "harmful outcome", "controller decision", "post-hoc scenario removal"]
  },
  "resource_estimate": {
    "simulation_raw_bytes": 1073741824,
    "ns3_raw_bytes": 134217728,
    "prototype_raw_bytes": 67108864,
    "logs_and_checksums_bytes": 268435456,
    "estimated_incremental_bytes": 1543503872
  }
}
