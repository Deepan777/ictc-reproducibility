    "minimum_per_arm": 10,
    "unsupported_context_action": "DEFER_TO_KEEP",
    "broader_fallback_for_unsupported_context": false,
    "mean_effect_not_individual_certificate": true
  },
  "execution_order": [
    "identification",
    "contract",
    "estimability",
    "frozen_support",
    "uncertainty",
    "context_effect_safety",
    "policy"
  ],
  "evaluation": {
    "split": "test",
    "expected_pair_count": 720,
    "matrix_file_sha256": "F5572579E9D351B7FFAF7C22A4D17F1EA07B3D5D1E9F45D828E8424F41270CA7",
    "generation_and_execution_require_single_use_authorization": true,
    "decisions_required_before_truth_join": true,
    "selective_exclusions": [],
    "failed_runs": "retain and classify",
    "reruns": "prohibited after authorization consumption"
  },
  "comparisons": {
    "ablation_suite": "A0-A16 frozen implementation",
    "baseline_suite_sha256": "08B47A58DACB169235A09E03BE771597073C747E2640C025B3CCFD34C5213B3C",
    "report_all_development_candidates_without_reselection": true
  },
  "primary_endpoints": [
    {
      "metric_id": "false_causal_admission_rate",
      "denominator": "reference non-identifiable opportunities"
    },
    {
      "metric_id": "harmful_event_burden",
      "denominator": "all paired opportunities"
    },
    {
      "metric_id": "conditional_harmful_action_rate",
      "denominator": "executed reroutes"
    }
  ],
  "decision_rule": {
    "allowed_values": ["CONTINUE", "REVISE PROBLEM", "NO-GO"],
    "continue_requires": [
      "zero false causal admissions",
      "selected gate retains at least 25 percent of base A0 reroutes",
      "selected gate reduces harmful-event burden versus base A0",
      "selected gate is not universal or near-universal deferral",
      "all access, persistence, support, and integrity checks pass"
    ],
    "revise_problem_when": "causal admissibility remains distinct but safety, support, calibration, or operational trade-offs are inadequate",
    "no_go_when": "integrity, leakage, authorization, identification, or contract invariants fail"
  },
  "prohibited_after_evaluation_open": [
    "threshold changes",
    "scope changes",
    "graph changes",
    "support-threshold changes",
    "metric amendments",
    "selective exclusions",
    "candidate reselection",
    "unclassified reruns"
  ]
